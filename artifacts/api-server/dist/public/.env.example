# ============================================================
# CTRL.PNL — Dashboard (Frontend) Environment Variables
# Set these BEFORE building the dashboard with `npm run build`.
# Vite bakes them into the JS bundle at build time.
# ============================================================

# ── API Server URL ───────────────────────────────────────────
# The full URL of your deployed API server.
# Leave empty ("") if the dashboard is served by the same server
# (the api-server already serves dashboard static files from /public).
VITE_API_BASE_URL=https://your-api.onrender.com

# ── Admin Credentials (baked into bundle at build time) ──────
# These must match what you set on the API server.
VITE_WORKER_API_KEY=WAK-your-key-here
VITE_TOTP_SECRET=your-base32-totp-secret
